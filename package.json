{
  "name": "pino-agent",
  "version": "0.1.2",
  "description": "Minimal Pi-based agent harness with Pino-owned state and bundled defaults",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rupertsworld/pino.git"
  },
  "bin": {
    "pino": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "default-state",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.ts",
    "pino": "node src/cli.ts",
    "test": "node --test test/**/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "commander": "^15.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
